@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="_isDarkMode"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggled" />
        <MudImage Src="@Logo" Height="40"/>
        <MudText Typo="Typo.h5">MediaButler</MudText>
        <MudSpacer />
        <MudIconButton OnClick="SwitchTheme" Icon="@(_isDarkMode ? @Icons.Material.Filled.LightMode : @Icons.Material.Filled.DarkMode)"/>
    </MudAppBar>
    <MudDrawer Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudNavMenu>
            
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code
{
    private bool _isDarkMode = true;
    private bool _drawerOpen = true;
    private string Logo => Assets["assets/logo-small.webp"];

    private void SwitchTheme()
    {
        _isDarkMode = !_isDarkMode;
    }

    private void DrawerToggled()
    {
        _drawerOpen = !_drawerOpen;
    }
}
