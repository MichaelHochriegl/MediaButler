<div id="blazor-error-ui" class="mud-elevation-20 blazor-error-card" data-nosnippet>
        <MudText Typo="Typo.h6">Something went wrong</MudText>
        <MudText Typo="Typo.body2">
            The app encountered an unrecoverable error. Please reload the page.
        </MudText>

        <MudButton Class="reload" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Refresh" Href=".">
            Refresh
        </MudButton>

    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
        <span class="dismiss">
            <MudIconButton Icon="@Icons.Material.Filled.Close"/>
        </span>
    </MudStack>
</div>