<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" aria-label="Connection status" data-nosnippet>
    <div class="components-reconnect-container mb-card">
        <div class="components-reconnect-main">
            <div class="components-reconnect-status" aria-hidden="true">
                <div class="components-rejoining-animation">
                    <div></div>
                    <div></div>
                </div>
                <div class="components-reconnect-state-icon components-reconnect-failed-visible">
                    <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Medium"/>
                </div>
                <div class="components-reconnect-state-icon components-pause-visible">
                    <MudIcon Icon="@Icons.Material.Filled.PauseCircle" Size="Size.Medium"/>
                </div>
                <div class="components-reconnect-state-icon components-resume-failed-visible">
                    <MudIcon Icon="@Icons.Material.Filled.SyncProblem" Size="Size.Medium"/>
                </div>
            </div>

            <div class="components-reconnect-copy" aria-live="polite">
                <p class="components-reconnect-eyebrow">Connection status</p>

                <div class="components-reconnect-first-attempt-visible">
                    <h2>Reconnecting</h2>
                    <p>Restoring your MediaButler session.</p>
                </div>

                <div class="components-reconnect-repeated-attempt-visible">
                    <h2>Still reconnecting</h2>
                    <p>
                        Trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
                    </p>
                </div>

                <div class="components-reconnect-failed-visible">
                    <h2>Connection lost</h2>
                    <p>Retry the session or reload the page.</p>
                </div>

                <div class="components-pause-visible">
                    <h2>Session paused</h2>
                    <p>The server paused this session.</p>
                </div>

                <div class="components-resume-failed-visible">
                    <h2>Resume failed</h2>
                    <p>Retry the session or reload the page.</p>
                </div>
            </div>
        </div>

        <div class="components-reconnect-actions">
            <button id="components-reconnect-button"
                    class="components-reconnect-action components-reconnect-failed-visible" type="button">
                <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"/>
                <span>Retry</span>
            </button>

            <button id="components-resume-button"
                    class="components-reconnect-action components-pause-visible components-resume-failed-visible"
                    type="button">
                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"/>
                <span>Resume</span>
            </button>
        </div>
    </div>
</dialog>
